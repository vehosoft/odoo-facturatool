<?xml version="1.0" encoding="utf-8"?>
<odoo>
		<data>
			<template id="external_layout_striped" inherit_id="web.external_layout_striped">
				<xpath expr="//div[@t-attf-class='o_company_#{company.id}_layout header']/div[@class='d-flex']/div[@class='ms-3']" position="replace">
					<div class="ms-3" name="company_address">
						<div t-field="company.name" style="font-size: 18px; font-weight: bold;"/>
						<div style="font-size: 18px;">RFC: <span t-field="company.vat"/></div>
						<div style="font-size: 15px;"  t-if="company.street or company.street2">
								<span t-field="company.street"/>,
								<span t-field="company.street2"/>
						</div>
						<div style="font-size: 15px;">
								<span t-field="company.city"/>, <span t-field="company.state_id.name"/>, <span t-field="company.country_id.name"/>, C.P.<span t-field="company.zip"/>
						</div>
						<div style="font-size: 12px;" t-if="company.company_registry"> Regimen Fiscal: <span t-field="company.company_registry"/> </div>
					</div>
				</xpath>
			</template>
			<template id="external_layout_bold" inherit_id="web.external_layout_bold">
					
					<xpath expr="//div[@t-attf-class='header o_company_#{company.id}_layout']/div[@class='row']" position="replace">
						<div class="row">
							<div class="col-4">
								<img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 45px; max-width:200px;" alt="Logo"/>
							</div>
							<div class="col-8" name="company_address">
								<div t-field="company.name" style="font-size: 18px; font-weight: bold;"/>
								<div style="font-size: 18px;">RFC: <span t-field="company.vat"/></div>
								<div style="font-size: 15px;">
										<span t-field="company.street"/>,
										<span t-field="company.street2"/>
								</div>
								<div style="font-size: 15px;">
										<span t-field="company.city"/>, <span t-field="company.state_id.code"/>, <span t-field="company.country_id.name"/>, C.P.<span t-field="company.zip"/>
								</div>
								<div style="font-size: 12px;"> Regimen Fiscal: <span t-field="company.company_registry"/> </div>
							</div>
						</div>
					</xpath>
					
					<xpath expr="//div[@t-attf-class=&quot;footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}&quot;]" position="replace">
						<div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
							<div class="o_footer_content row border-top pt-2">
								<div class="col-10">
									<t t-if="company.phone">
										Tel.: <span t-esc="company.phone"/> |
									</t>
									<t t-if="company.email">
										Email: <span t-esc="company.email"/> |
									</t>
									<t t-if="company.website">
										Website: <span t-esc="company.website"/>
									</t>
								</div>
								<div class="col-2 text-end">
									<strong t-if="company.report_header" t-field="company.report_header" class="o_company_tagline">Company tagline</strong>
									<span t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted" t-out="str(o.name) + ', '">(document name)</span>
									<span t-if="report_type == 'pdf'" class="text-muted">Page <span class="page"/> / <span class="topage"/></span>
								</div>
							</div>
						</div>
					</xpath>
					

			</template>

		</data>
</odoo>
